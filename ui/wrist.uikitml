<!--
  The menu button on your left wrist (sdk/wrist.js): 60 x 60, three bars (the site's menu button), the site's
  colors. It shows while your left palm faces you; touch it with a finger of your right hand (or point and pinch)
  to open the menu.
-->
<style>
  .button {
    width: 60px;
    height: 60px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 7px;
    background-color: #24150d;
    border-width: 3px;
    border-color: #F2E8D5;
    border-radius: 10px;
  }
  .lit {
    background-color: #8C2B22;
  }
  .line {
    width: 30px;
    height: 4px;
    border-radius: 2px;
    background-color: #F2E8D5;
  }
</style>
<div id="button" class="button">
  <div class="line"></div>
  <div class="line"></div>
  <div class="line"></div>
</div>
