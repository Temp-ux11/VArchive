<!--
  THE SITE PANEL (sdk/site-panel.js): the site's three pages in the headset, Overview, Articles and Corkboard, as
  tabs down its left side. The tab chosen slides out and joins the panel; its page loads into the panel.
  It stands 1 m away, for reading, sized in Meta's units: 1 px here is 1 dp (1 dp = 3/48 of a degree, about 1.1 mm
  at 1 m). Body text is 20 dp, titles 36 to 40 dp, and every tab and button is at least 48 dp tall (Meta's
  smallest target). Drawn at 0.65 mm a px, the tabs and the page's cards are 20 px apart: Meta's 12 mm between
  targets (sdk/panels.js TARGET). The page is filled in code; what doesn't fit scrolls. Colors: the site's (styles.css), every
  text color at least 4.5:1 against what it sits on.
-->
<style>
  .frame {
    flex-direction: row;
    align-items: flex-start;
    width: 1060px;
    height: 600px;
  }
  .tabs {
    flex-direction: column;
    align-items: flex-end;
    flex-shrink: 0;
    width: 160px;
    padding-top: 84px;
    gap: 20px;
  }
  .panel {
    flex-direction: column;
    flex-grow: 1;
    height: 600px;
    background-color: #24150d;
    border-width: 2px;
    border-color: #6b4a36;
    border-radius: 16px;
    overflow: hidden;
  }
  .bar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 68px;
    padding-left: 32px;
    padding-right: 12px;
    background-color: #1a0f09;
    border-bottom-width: 1px;
    border-color: #6b4a36;
  }
  .kicker {
    flex-grow: 1;
    flex-shrink: 1;
    color: #bfae94;
    font-size: 18px;
    letter-spacing: 3px;
  }
  .close {
    width: 48px;
    height: 48px;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    border-width: 2px;
    border-color: #F2E8D5;
  }
  .close:hover {
    background-color: #8C2B22;
  }
  .x {
    color: #F2E8D5;
    font-size: 22px;
  }
  .page {
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    overflow: scroll;
    padding-top: 26px;
    padding-bottom: 36px;
    padding-left: 40px;
    padding-right: 40px;
    gap: 20px;
  }
</style>
<div class="frame">
  <div id="tabs" class="tabs"></div>
  <div class="panel">
    <div class="bar">
      <span id="title" class="kicker">Overview</span>
      <div id="close" class="close"><span class="x">✕</span></div>
    </div>
    <div id="page" class="page"></div>
  </div>
</div>
